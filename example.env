# Your Google Gemini / Google AI Studio API Key
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemma / Gemini Model Identifier
# Primary recommended model: gemma-4-26b-a4b-it (Multimodal MoE)
# Alternative supported models:
# - gemini-2.5-flash
# - gemini-2.0-flash
# - gemini-1.5-flash
# - gemini-1.5-pro
GEMINI_MODEL=gemma-4-26b-a4b-it
